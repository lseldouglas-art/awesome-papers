# Optional NCBI identity and higher-rate access.
NCBI_EMAIL=researcher@example.org
NCBI_TOOL=pi-research-workbench
NCBI_API_KEY=

# Optional standalone live-model runtime. Inside Pi, supported OpenAI or
# Anthropic credentials can be resolved from Pi's current model registry.
RESEARCH_AGENT_PROVIDER=openai
RESEARCH_AGENT_MODEL=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# auto | live | guided. Guided results are always labeled restricted.
RESEARCH_AGENT_FORCE_MODE=auto

# Defaults to <current project>/.pi/research-workbench-data. Use an absolute
# path appropriate for your platform, for example:
# PI_RESEARCH_DATA_DIR=/Users/name/research-data
# PI_RESEARCH_DATA_DIR=C:\\Users\\name\\research-data

# Stable local owner identity used to authorize human decisions.
PI_RESEARCHER_ID=local-researcher
