{
  "name": "pi-research-workbench",
  "version": "0.1.0",
  "description": "A state-machine-governed Pi package for traceable PubMed evidence review, human gates, citation checks, and audited review outputs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi-package",
    "research-agent",
    "pubmed",
    "evidence-synthesis",
    "state-machine"
  ],
  "bin": {
    "research-pi": "./cli/research-pi.js"
  },
  "exports": {
    ".": "./extensions/index.js",
    "./service": "./research-agent-service-v1.js",
    "./machine": "./review-research-machine-v1.js",
    "./gateway": "./research-tool-gateway-v1.js",
    "./config-schema": "./config-schema-v1.js",
    "./runtime-provenance": "./agent-run-log-v1.js",
    "./formal-authority": "./research-formal-authority-v1.js",
    "./export-authority": "./export-authority-v1.js",
    "./literature-landscape": "./research-literature-landscape-v1.js",
    "./literature-landscape-contracts": "./research-literature-landscape-contracts-v1.js",
    "./idea-validation": "./idea-validation-v1.js"
  },
  "files": [
    "*.js",
    "extensions/*.js",
    "skills/*/SKILL.md",
    "prompts/*.md",
    "cli/*.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".env.example"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "skills": [
      "./skills/scientific-research"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  },
  "scripts": {
    "test": "node --test pi-package-v1.test.mjs",
    "test:core": "node --test *.test.mjs fixtures/*.test.mjs",
    "check:syntax": "node --check extensions/index.js && node --check cli/research-pi.js && node --check research-agent-service-v1.js && node --check pi-runtime-adapter-v1.js",
    "pack:check": "node scripts/pack-check.mjs",
    "test:install": "node scripts/package-install-smoke.mjs",
    "check": "npm run check:syntax && npm test && npm run pack:check && npm run test:install",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  }
}
