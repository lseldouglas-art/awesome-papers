# Server
RESEARCH_WORKBENCH_HOST=127.0.0.1
RESEARCH_WORKBENCH_PORT=5177
RESEARCH_WORKBENCH_DATA_DIR=.research-workbench-data
RESEARCH_WORKBENCH_OWNER_ID=local-researcher

# Optional HTTP Basic Auth for a private hosted instance.
# Configure both values together; never commit real credentials.
RESEARCH_WORKBENCH_AUTH_USERNAME=
RESEARCH_WORKBENCH_AUTH_PASSWORD=

# NCBI recommends identifying the client. API keys are optional.
NCBI_EMAIL=
NCBI_TOOL=research-workbench
NCBI_API_KEY=

# Optional live model provider. Without it, the workbench runs in guided mode
# and keeps all generated content explicitly non-authoritative.
RESEARCH_AGENT_PROVIDER=
RESEARCH_AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
