# Optional local terminal proxy. Replace with this machine's actual proxy port.
# Model API keys belong in the app's private model settings, never this file.
HTTP_PROXY=http://127.0.0.1:17891
HTTPS_PROXY=http://127.0.0.1:17891
ALL_PROXY=http://127.0.0.1:17891
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
# Optional: use a separate local demo port and data directory.
# RW_DEMO_PORT=4320
# RW_DEMO_DATA_DIR=demo-api/.local/my-demo
